{
  "manifest_version": 3,
  "name": "DualRead 개인 번역기",
  "description": "페이지 전체 또는 드래그한 글을 ChatGPT 구독이나 지정한 서버로 번역해 원문 아래에 표시합니다.",
  "version": "0.13.3",
  "minimum_chrome_version": "120",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DualRead 개인 번역기"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "translate-page": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "페이지 전체 번역 켜기·끄기"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "드래그한 글만 번역"
    },
    "pick-paragraph": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "번역할 문단 직접 고르기"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src https: http://127.0.0.1:* http://localhost:*; base-uri 'none'; frame-src 'none'; form-action 'none'"
  },
  "default_locale": "en"
}
